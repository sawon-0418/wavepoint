# 실제 키는 .env 파일에만 저장하세요. 이 파일은 그대로 두어도 됩니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 로컬 개발은 127.0.0.1, 배포 플랫폼에서는 플랫폼이 요구하는 HOST/PORT를 사용하세요.
HOST=127.0.0.1
PORT=4173
# HTTPS 배포 뒤 true로 바꾸면 로그인 쿠키에 Secure 속성을 강제합니다.
FORCE_SECURE_COOKIES=false
FISHING_SPOTS_API_KEY=
FISHING_SPOTS_API_URL=
PROTECTED_AREAS_API_KEY=
# WFS GetFeature JSON 요청 주소를 붙여넣으세요. 예: ...?service=WFS&request=GetFeature&typeNames=...&outputFormat=application/json
PROTECTED_AREAS_WFS_URL=
# WMS 조회 서비스제공주소: 보호구역 이미지 레이어(선택 기능)입니다.
PROTECTED_AREAS_WMS_URL=
# 네이버 지도 JavaScript API의 ncpKeyId입니다. 웹 서비스 URL 등록도 함께 완료하세요.
NAVER_MAPS_NCP_KEY_ID=
# 서버 측 주소 보완용 키를 발급받은 경우에만 입력합니다. 클라이언트에 노출하지 마세요.
NAVER_MAPS_CLIENT_SECRET=
# WFS 요청 범위(EPSG:5179). 전국 기본값입니다.
PROTECTED_AREAS_BBOX=700000,1300000,1400000,2200000
# 공식 데이터 자동 동기화 시각(한국 시간)입니다.
DAILY_SYNC_HOUR=3
DAILY_SYNC_MINUTE=30
# 프로덕션에서는 GitHub Actions가 동기화를 담당하므로 false로 설정하세요. 로컬 개발에서는 true를 유지할 수 있습니다.
RUN_IN_PROCESS_SYNC=true
